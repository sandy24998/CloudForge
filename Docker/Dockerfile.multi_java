FROM openjdk:21 as builder

WORKDIR /app
COPY target/app.jar app.jar

FROM openjdk:21-jre-slim
WORKDIR /app

#RUN groupadd --system devops && useradd --system -g devops -m sandeep
#RUN groupadd -r devops && useradd -r -g devops -m sandeep

RUN addgroup --system devops && adduser --system sandeep --ingroup devops
COPY --from=builder /app/app.jar app.jar
RUN chown sandeep:devops app.jar

USER sandeep
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]